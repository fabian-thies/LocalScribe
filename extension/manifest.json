{
  "manifest_version": 3,
  "name": "Meeting Transcriber",
  "description": "Record tab and microphone audio, create private transcripts with local Open WebUI, and save meeting notes on your device.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Meeting Transcriber"
  },
  "background": {
    "service_worker": "assets/serviceWorker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
