{
  "manifest_version": 3,
  "name": "Voxbound",
  "description": "Record tab and microphone audio, transcribe through Open WebUI, and save meeting notes on your device.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/fabian-thies/meeting-transcoder",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Voxbound"
  },
  "background": {
    "service_worker": "assets/serviceWorker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
