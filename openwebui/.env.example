OPEN_WEBUI_PORT=3000
OLLAMA_HOST_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_MODEL=gemma4:latest
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_MULTILINGUAL=true
WHISPER_COMPUTE_TYPE=int8

# Open WebUI configuration changes across releases. Keep version-specific STT
# variables here so the Docker Compose file and extension stay clean.
ENABLE_AUDIO_STT=true
WEBUI_AUTH=true
